[Unit]
Description=Maotai RAG Streamlit web (systemd user service)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
EnvironmentFile=__ROOT__/.env
Environment=NO_PROXY=localhost,127.0.0.1
ExecStart=__VENV__/bin/python -m streamlit run src/app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=3

[Install]
WantedBy=default.target