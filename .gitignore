# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# 数据产物（可由脚本重新生成或下载）；
# 例外：语境增强索引随仓库分发（5.5MB），克隆即可复现评测/问答，
# 也是 CI 检索层评测回归（.github/workflows/eval-gate.yml）的数据来源
data/raw_pdfs/
data/extracted/
data/extracted_tables/
# 表格增强页随仓库分发（2.6MB；无 committed 重建脚本，口径分类器依赖）
!data/extracted_tables_plus/
data/db/
data/models/
data/index/*
!data/index/contextual.npz
data/chunks/*
!data/chunks/contextual.jsonl

# 评测与构建产物
results/ci_retrieval_run.json
report/*.pdf
report/_build/
*.aux
*.log
*.out

# 环境与密钥
.env
*.key

# 会话内部文件
.zcode/

# 交接文件（不入库）
HANDOFF.md
.handoff/
# 评审过程的临时脚本与中间输出（仅供本地复算，不入库）
review/_lead/
review/_recalc/

# 本地实时看板（脚本可再生、体积大，不入库；架构图以 README mermaid 为准）
docs/dashboard.html
scripts/assets/mermaid.min.js

# 轴4 坐标核验高亮图（scripts/make_citation_crops.py 可再生；清单入库）
docs/citations/

# 阶段2 前端产物与本地 npm 缓存（不落 C 盘、不入库）
web/node_modules/
web/dist/
.npm-cache/

# Linux 运行日志与诊断脚本（supervise.sh / start_local_linux.sh 可再生）
logs/
